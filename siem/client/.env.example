# siem-client/.env  (cp .env.example .env). Prioridad: variable real del OS > .env > defecto.
APP_ENV=production
APP_DEBUG=0
APP_NAME=siem-client

# A donde se envia: la url completa del endpoint de ingesta del backend y el api_token del agente
# (lo imprime una sola vez ./console agent-create en el backend). El token nunca va en siem-client.json.
APP_SIEM_ENDPOINT_URL=http://localhost:9400/api/v1/ingest-batches
APP_SIEM_API_TOKEN=

# 1 (defecto): lo que se vigila baja del panel del backend (monitores: cpu, memoria, disco, gpu, red, carpetas, patrones
# de log) cada 60 s, y siem-client.json pasa a ser opcional (si existe, se suma). 0 = solo siem-client.json.
APP_SIEM_REMOTE_CONFIG=1

# Lo que se vigila en local (carpetas, comandos, docker): ver config/siem-client.example.json. Opcional con la config remota.
# Por defecto: desde el repo, config/siem-client.json; como binario suelto, siem-client.json junto al binario.
#APP_CONFIG_PATH=%PATH_ROOT%/config/siem-client.json

# Por defecto en storage/ (repo) o junto al binario: logs, spool (eventos sin enviar) y state (hasta donde se leyo).
#APP_LOG_PATH=%PATH_ROOT%/storage/logs
#APP_SPOOL_PATH=%PATH_ROOT%/storage/spool
#APP_STATE_PATH=%PATH_ROOT%/storage/state
