# docker/.env  --  cp docker/.env.example docker/.env   (o make env)

# api_token del agente: ./console agent-create en el backend (lo imprime una sola vez).
APP_SIEM_API_TOKEN=

# TZ del contenedor.
TIME_ZONE=UTC

# carpeta del host que vigila el agente en local (montada en solo lectura en /watch/host). Vacio = storage/demo-logs.
# Windows con barras normales: C:/projects/claude-tmp/siem-watch
SIEM_WATCH_HOST_PATH=
