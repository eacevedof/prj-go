root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.go]
indent_style = space
indent_size = 4

# makefiles tambien a 4 espacios: el makefile cambia el prefijo de receta a un espacio (.RECIPEPREFIX)
[{makefile,Makefile}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
