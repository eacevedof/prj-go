# siem/backend/.env  (cp .env.example .env, o make env)
APP_ENV=local
APP_DEBUG=0
APP_DEFAULT_LANG=es
APP_DOMAIN=localhost:9400
APP_SQLITE_PATH=%PATH_ROOT%/database/siem.sqlite

APP_LOG_PATH=%PATH_ROOT%/storage/logs
APP_NAME=siem-backend
APP_BASE_URL=http://localhost:9400

# Bearer que pide el front (dashboard). Vacio = nadie entra. Generar uno: openssl rand -hex 32
APP_DASHBOARD_TOKEN=

# cada cuantos segundos el worker de la API vacia ingest_queue (0 = apagado: ./console ingest-queue-process)
APP_QUEUE_WORKER_INTERVAL_SECONDS=2
# dias que se conservan los eventos (./console events-purge)
APP_EVENTS_RETENTION_DAYS=30

# emails de alerta ante un 500 (MailTrait). Vacio APP_EMAIL_TO = alertas desactivadas.
APP_EMAIL_TO=
APP_EMAIL_FROM=alerts@siem.loc
APP_SENDMAIL_PATH=/usr/sbin/sendmail -t -i
