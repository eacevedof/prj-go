# trafficker/.env  (cp .env.example .env). Prioridad: variable real del OS > .env > defecto.
APP_ENV=production
APP_DEBUG=0
APP_NAME=trafficker

# A donde se envia: la url completa del endpoint de ingesta del backend del siem y el api_token del agente
# (alta del agente en el panel del siem; el token se muestra una sola vez).
APP_SIEM_ENDPOINT_URL=http://localhost:9400/api/v1/ingest-batches
APP_SIEM_API_TOKEN=

# Cada cuanto se hace la foto de los sockets y cada cuanto se envia el spool (segundos).
APP_COLLECT_INTERVAL_SECONDS=5
APP_SEND_INTERVAL_SECONDS=30

# Filtros: loopback (127.0.0.0/8, ::1) fuera salvo 1; procesos (nombre corto) y puertos a ignorar, separados por comas.
APP_INCLUDE_LOOPBACK=0
APP_IGNORE_PROCESSES=
APP_IGNORE_PORTS=

# Por defecto en storage/ (repo) o junto al binario: logs, spool (eventos sin enviar) y state (la ultima foto).
#APP_LOG_PATH=%PATH_ROOT%/storage/logs
#APP_SPOOL_PATH=%PATH_ROOT%/storage/spool
#APP_STATE_PATH=%PATH_ROOT%/storage/state

# Raiz de /proc (solo para leer el /proc del host montado en otra ruta).
#APP_PROC_PATH=/proc
