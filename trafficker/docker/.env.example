# docker/.env  --  cp docker/.env.example docker/.env   (o make env)

# endpoint de ingesta del backend del siem y api_token del agente (alta en el panel del siem; se muestra una vez).
APP_SIEM_ENDPOINT_URL=http://localhost:9400/api/v1/ingest-batches
APP_SIEM_API_TOKEN=

# TZ del contenedor.
TIME_ZONE=UTC
