# notifier/backend/.env  (cp .env.example .env, o make env)
APP_ENV=local
APP_DEBUG=0
APP_DEFAULT_LANG=es
APP_DOMAIN=localhost:9500
APP_SQLITE_PATH=%PATH_ROOT%/database/notifier.sqlite

APP_LOG_PATH=%PATH_ROOT%/storage/logs
APP_NAME=notifier-backend
APP_BASE_URL=http://localhost:9500

# clave con la que se cifran los secretos de los perfiles de envio (AES-256-GCM). Obligatoria, minimo 32 caracteres.
# Generar una: openssl rand -hex 32. Si se cambia, hay que volver a meter el secreto de cada perfil.
APP_SECRETS_KEY=

# cada cuantos segundos los workers de la API vacian su cola (0 = apagados: ./console message-queue-process)
APP_QUEUE_WORKER_INTERVAL_SECONDS=5
# tope de destinatarios (to + cc + bcc) de un mensaje
APP_MESSAGE_MAX_RECIPIENTS=50
# hosts de los que se pueden descargar adjuntos por url (https), separados por comas. Vacio = ninguno.
APP_ATTACHMENT_ALLOWED_HOSTS=
# tope de tamano de cada adjunto (bytes) y tiempo maximo de descarga (segundos)
APP_ATTACHMENT_MAX_BYTES=10485760
APP_ATTACHMENT_TIMEOUT_SECONDS=20

# emails de alerta ante un 500 (MailTrait). Vacio APP_EMAIL_TO = alertas desactivadas.
APP_EMAIL_TO=
APP_EMAIL_FROM=alerts@notifier.loc
APP_SENDMAIL_PATH=/usr/sbin/sendmail -t -i
