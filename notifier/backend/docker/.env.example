# docker/.env  --  opcional: el compose trae defaults para todo.
#   cp docker/.env.example docker/.env   (o make env)

# Puerto del host para la API (http://localhost:9500). Solo en 127.0.0.1.
HTTP_PORT=9500
# Mailpit en local: SMTP (para el perfil smtp_custom, desde la API es mailpit:1025) y su web (http://localhost:9525)
MAILPIT_WEB_PORT=9525

# TZ del contenedor.
TIME_ZONE=UTC
