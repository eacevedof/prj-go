// Dev Containers: VS Code dentro de cont-siem-client-app para usar su Go (1.26, alpine) sin instalar Go en Windows.
// Reutiliza el compose del proyecto (name: siem-client): NO crea contenedores nuevos, se engancha al de "make up".
// Coste extra solo mientras VS Code esta conectado: VS Code Server + gopls dentro del contenedor.
{
    "name": "siem-client",
    "dockerComposeFile": ["../../siem/client/docker/docker-compose.yml"],
    "service": "siem-client-app",
    "runServices": ["siem-client-app"],
    "workspaceFolder": "/app",
    "shutdownAction": "none",

    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go"
            ],
            "settings": {
                "go.toolsManagement.autoUpdate": false,
                "editor.insertSpaces": true,
                "editor.tabSize": 4,
                "go.formatTool": "default",
                "[go]": { "editor.formatOnSave": false },
                "terminal.integrated.defaultProfile.linux": "sh",
                "terminal.integrated.profiles.linux": {
                    "sh": { "path": "/bin/sh" }
                }
            }
        }
    }
}
